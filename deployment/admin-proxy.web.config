<?xml version="1.0" encoding="utf-8"?>
<!-- IIS requires URL Rewrite and Application Request Routing with proxy enabled. -->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="8388608" />
      </requestFiltering>
    </security>
    <rewrite>
      <rules>
        <rule name="DonatoAdminProxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3030/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
